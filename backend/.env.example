SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/job_portal?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=your_mysql_user
SPRING_DATASOURCE_PASSWORD=your_mysql_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_SQL_INIT_MODE=never
SERVER_PORT=8080
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION=86400000
APP_CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
